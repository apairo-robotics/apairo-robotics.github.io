---
const links = [
  { label: "Profile", href: "#profile" },
  { label: "The stack", href: "#stack" },
  { label: "Packages", href: "#packages" },
  { label: "Quickstart", href: "#quickstart" },
];
---

<header class="nav" data-nav>
  <div class="wrap nav-inner">
    <a class="brand" href="/" aria-label="apairo — home">
      <img src="/assets/apairo_mark.svg" alt="" width="30" height="30" />
      <span class="brand-word">apairo</span>
      <span class="brand-org mono">/ robotics</span>
    </a>

    <nav class="nav-links mono" aria-label="Primary">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <a class="nav-cta mono" href="https://github.com/apairo-robotics" target="_blank" rel="noopener">
      GitHub
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M7 17 17 7M9 7h8v8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 78%, transparent);
    backdrop-filter: saturate(140%) blur(10px);
    -webkit-backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.4s var(--ease), background 0.4s var(--ease);
  }
  .nav[data-scrolled] {
    border-bottom-color: var(--line);
    background: color-mix(in srgb, var(--paper) 90%, transparent);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 68px;
  }
  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  .brand img { align-self: center; }
  .brand-word {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .brand-org {
    font-size: 0.7rem;
    color: var(--steel);
    letter-spacing: 0.04em;
  }
  .nav-links {
    margin-left: auto;
    display: flex;
    gap: 1.8rem;
    font-size: 0.82rem;
    letter-spacing: 0.01em;
  }
  .nav-links a {
    color: var(--ink-2);
    position: relative;
    padding-block: 0.4rem;
    transition: color 0.3s var(--ease);
  }
  .nav-links a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: var(--spark);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s var(--ease);
  }
  .nav-links a:hover { color: var(--ink); }
  .nav-links a:hover::after { transform: scaleX(1); }

  .nav-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-size: 0.8rem;
    color: var(--ink);
    border: 1px solid var(--line-strong);
    padding: 0.5em 0.95em;
    border-radius: 999px;
    transition: border-color 0.3s var(--ease), color 0.3s var(--ease);
  }
  .nav-cta:hover { border-color: var(--ink); color: var(--spark-ink); }

  @media (max-width: 760px) {
    .nav-links { display: none; }
    .nav-cta { margin-left: auto; }
  }
</style>
