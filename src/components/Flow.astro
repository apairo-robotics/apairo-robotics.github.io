---
const stages = [
  { i: "01", verb: "Extract",    pkg: "apairo_extractor",   desc: "ROS 1 · ROS 2 · MCAP bags → .apairo", href: "https://github.com/apairo-robotics/apairo_extractor" },
  { i: "02", verb: "Profile",    pkg: "apairo",             desc: "Every channel, in one command",       href: "#profile", core: true },
  { i: "03", verb: "Load",       pkg: "apairo",             desc: "Sync & multi-rate, plain numpy",      href: "https://github.com/apairo-robotics/apairo", core: true },
  { i: "04", verb: "Transform",  pkg: "apairo_transform",   desc: "Lazy runtime augmentations",          href: "https://github.com/apairo-robotics/apairo_transform" },
  { i: "05", verb: "Preprocess", pkg: "apairo_preprocess",  desc: "Offline odometry & ground truth",     href: "https://github.com/apairo-robotics/apairo_preprocess" },
  { i: "06", verb: "Visualise",  pkg: "apairo_visu",        desc: "Studio, Open3D & Rerun",              href: "https://github.com/apairo-robotics/apairo_visu" },
  { i: "07", verb: "Share",      pkg: "apairo_huggingface", desc: "LeRobot datasets on the Hub",         href: "https://github.com/apairo-robotics/apairo_huggingface" },
];

const isExternal = (href: string) => href.startsWith("http");
---

<section id="stack" class="section flow">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <p class="eyebrow">02 / The stack</p>
      <h2>Six packages, one pipeline.</h2>
      <p>
        Each package does one thing well and snaps onto the next. Start anywhere —
        the <strong>apairo</strong> core is the only hard dependency.
      </p>
    </div>

    <div class="track" data-reveal style="--delay: 120ms">
      <div class="rail-line" aria-hidden="true"></div>
      <div class="shuttle" aria-hidden="true"><span class="token"></span></div>

      <ol class="stations">
        {stages.map((s) => (
          <li class={s.core ? "station station--core" : "station"}>
            <a
              href={s.href}
              target={isExternal(s.href) ? "_blank" : undefined}
              rel={isExternal(s.href) ? "noopener" : undefined}
            >
              <span class="node" aria-hidden="true"><span class="dot"></span></span>
              <span class="st-index mono">{s.i}</span>
              <h3 class="st-verb">{s.verb}</h3>
              <span class="st-pkg mono">{s.pkg}{s.core && <em class="core-tag"> core</em>}</span>
              <span class="st-desc">{s.desc}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .flow { padding-bottom: clamp(3rem, 7vw, 5rem); }
  .section-head strong { font-weight: 600; }

  .track { position: relative; padding-top: 0.5rem; }

  /* rail and token run through the node centres (track padding + half a node) */
  .rail-line {
    position: absolute;
    left: 0; right: 0;
    top: calc(0.5rem + 7px);
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--line-strong) 4%, var(--line-strong) 96%, transparent);
  }

  .shuttle {
    position: absolute;
    top: calc(0.5rem + 7.5px);
    left: 8px;
    width: 0; height: 0;
    animation: shuttle 15s ease-in-out infinite alternate;
  }
  .token {
    position: absolute;
    top: -5px; left: -5px;
    width: 10px; height: 10px;
    border-radius: 50%;
    background: var(--spark);
    box-shadow: 0 0 0 4px var(--spark-glow), 0 0 12px 1px rgba(221,164,42,0.45);
    animation: pulse 1.5s ease-in-out infinite;
  }

  .stations {
    list-style: none;
    margin: 0; padding: 0;
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 0.5rem;
  }
  .station a {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.18rem;
    padding-right: 0.6rem;
  }

  .node {
    display: grid;
    place-items: center;
    width: 15px; height: 15px;
    border-radius: 50%;
    background: var(--paper);
    border: 1.5px solid var(--line-strong);
    margin-bottom: 1.1rem;
    transition: border-color 0.35s var(--ease), transform 0.35s var(--ease);
  }
  .dot {
    width: 5px; height: 5px;
    border-radius: 50%;
    background: var(--steel);
    transition: background 0.35s var(--ease);
  }
  .station--core .node {
    border-color: var(--spark);
    width: 18px; height: 18px;
    box-shadow: 0 0 0 5px var(--spark-glow);
    /* larger node, same centre and text baseline as its neighbours */
    margin: -1.5px 0 calc(1.1rem - 1.5px) -1.5px;
  }
  .station--core .dot { background: var(--spark); }

  .st-index { font-size: 0.68rem; color: var(--steel); letter-spacing: 0.1em; }
  .st-verb {
    font-size: 1.12rem;
    font-weight: 480;
    letter-spacing: -0.01em;
  }
  .st-pkg {
    font-size: 0.7rem;
    color: var(--ink-2);
    word-break: break-word;
  }
  .core-tag {
    color: var(--spark-ink);
    font-style: normal;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.6rem;
  }
  .st-desc {
    font-size: 0.83rem;
    color: var(--steel);
    line-height: 1.45;
    margin-top: 0.15rem;
  }

  /* hover lift */
  .station a:hover .node { border-color: var(--spark); transform: scale(1.18); }
  .station a:hover .dot { background: var(--spark); }
  .station a:hover .st-verb { color: var(--spark-ink); }
  .station a { transition: transform 0.35s var(--ease); }
  .station a:hover { transform: translateY(-3px); }

  /* The token rests on each node: column i starts at i·(100% + gap)/7. */
  @keyframes shuttle {
    0%, 6%         { left: calc((100% + 0.5rem) * 0 / 7 + 8px); }
    15.67%, 21.67% { left: calc((100% + 0.5rem) * 1 / 7 + 8px); }
    31.33%, 37.33% { left: calc((100% + 0.5rem) * 2 / 7 + 8px); }
    47%, 53%       { left: calc((100% + 0.5rem) * 3 / 7 + 8px); }
    62.67%, 68.67% { left: calc((100% + 0.5rem) * 4 / 7 + 8px); }
    78.33%, 84.33% { left: calc((100% + 0.5rem) * 5 / 7 + 8px); }
    94%, 100%      { left: calc((100% + 0.5rem) * 6 / 7 + 8px); }
  }
  @keyframes pulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50%      { transform: scale(1.35); opacity: 0.75; }
  }

  @media (max-width: 1020px) {
    .shuttle { display: none; }
    .rail-line {
      top: 0; bottom: 0; left: 7px; right: auto;
      width: 1px; height: auto;
      background: linear-gradient(180deg, transparent, var(--line-strong) 4%, var(--line-strong) 96%, transparent);
    }
    .stations { grid-template-columns: 1fr; gap: 1.6rem; }
    .station a { padding-left: 2rem; padding-right: 0; }
    .node { position: absolute; left: 0; margin-bottom: 0; }
    .station { position: relative; }
  }
  @media (prefers-reduced-motion: reduce) {
    .shuttle, .token { animation: none; }
  }
</style>
