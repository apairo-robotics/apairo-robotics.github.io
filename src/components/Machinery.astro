---
/*
  Discreet "machining" motif: two slowly-rotating encoder wheels and a gantry
  whose tool-head traces an ochre profile left→right, then retraces it back.
  All motion is CSS; it pauses under prefers-reduced-motion.
*/
type Wheel = { cx: number; cy: number; r: number; ticks: number; inset: number };

const wheelA: Wheel = { cx: 134, cy: 132, r: 82, ticks: 44, inset: 11 };
const wheelB: Wheel = { cx: 252, cy: 80, r: 46, ticks: 26, inset: 8 };

function ticks(w: Wheel) {
  return Array.from({ length: w.ticks }, (_, i) => {
    const a = (i / w.ticks) * Math.PI * 2;
    const r1 = w.r - w.inset;
    const r2 = w.r;
    return {
      x1: +(w.cx + Math.cos(a) * r1).toFixed(2),
      y1: +(w.cy + Math.sin(a) * r1).toFixed(2),
      x2: +(w.cx + Math.cos(a) * r2).toFixed(2),
      y2: +(w.cy + Math.sin(a) * r2).toFixed(2),
      lead: i === 0,
    };
  });
}
---

<figure class="machine" aria-hidden="true">
  <svg viewBox="0 0 420 400" fill="none" role="presentation">
    <!-- encoder wheel A -->
    <g class="wheel wheel--a">
      <circle cx={wheelA.cx} cy={wheelA.cy} r={wheelA.r} class="rim" />
      <circle cx={wheelA.cx} cy={wheelA.cy} r={wheelA.r - wheelA.inset - 6} class="rim rim--inner" />
      <circle cx={wheelA.cx} cy={wheelA.cy} r="9" class="hub" />
      {ticks(wheelA).map((t) => (
        <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} class={t.lead ? "tick tick--lead" : "tick"} />
      ))}
    </g>

    <!-- encoder wheel B -->
    <g class="wheel wheel--b">
      <circle cx={wheelB.cx} cy={wheelB.cy} r={wheelB.r} class="rim" />
      <circle cx={wheelB.cx} cy={wheelB.cy} r="6" class="hub" />
      {ticks(wheelB).map((t) => (
        <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} class={t.lead ? "tick tick--lead" : "tick"} />
      ))}
    </g>

    <!-- gantry rail + measure ticks -->
    <g class="rail">
      <line x1="36" y1="332" x2="384" y2="332" class="rail-bar" />
      {Array.from({ length: 19 }, (_, i) => 36 + i * 19.3).map((x) => (
        <line x1={+x.toFixed(1)} y1="332" x2={+x.toFixed(1)} y2="338" class="rail-tick" />
      ))}
      <line x1="36" y1="320" x2="36" y2="344" class="post" />
      <line x1="384" y1="320" x2="384" y2="344" class="post" />
    </g>

    <!-- machined profile (the cut), drawn in sync with the head -->
    <path
      class="profile"
      pathLength="100"
      d="M44,300 C 108,300 120,272 188,276 C 246,279 250,304 300,298 C 338,294 352,302 376,300"
    />

    <!-- tool head travelling along the gantry -->
    <g class="head">
      <line x1="0" y1="206" x2="0" y2="300" class="spindle" />
      <rect x="-15" y="196" width="30" height="12" rx="3" class="carriage" />
      <line x1="-15" y1="202" x2="-34" y2="202" class="carriage-arm" />
      <circle cx="0" cy="300" r="3.4" class="cutpoint" />
    </g>
  </svg>
</figure>

<style>
  .machine {
    margin: 0;
    width: 100%;
    max-width: 460px;
    filter: drop-shadow(0 24px 40px rgba(35, 44, 54, 0.08));
  }
  .machine svg { width: 100%; height: auto; display: block; overflow: visible; }

  /* base strokes — low-contrast charcoal */
  .rim, .tick, .rail-bar, .rail-tick, .post, .spindle, .carriage-arm {
    stroke: var(--ink-2);
  }
  .rim { stroke-width: 1.4; opacity: 0.42; }
  .rim--inner { opacity: 0.22; }
  .tick { stroke-width: 1.4; stroke-linecap: round; opacity: 0.4; }
  .tick--lead { stroke: var(--spark); opacity: 0.95; stroke-width: 2; }
  .hub { fill: var(--ink-2); opacity: 0.5; }

  .rail-bar { stroke-width: 1.6; opacity: 0.5; }
  .rail-tick { stroke-width: 1; opacity: 0.28; }
  .post { stroke-width: 1.6; opacity: 0.5; stroke-linecap: round; }

  .spindle { stroke-width: 1.4; opacity: 0.5; }
  .carriage { fill: var(--paper); stroke: var(--ink-2); stroke-width: 1.5; }
  .carriage-arm { stroke-width: 1.5; opacity: 0.6; stroke-linecap: round; }
  .cutpoint { fill: var(--spark); }

  .profile {
    stroke: var(--spark);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
  }

  /* ---- motion ---- */
  .wheel { transform-box: fill-box; transform-origin: center; }
  .wheel--a { animation: spin 46s linear infinite; }
  .wheel--b { animation: spin 27s linear infinite reverse; }

  .head { animation: travel 7s cubic-bezier(0.5, 0, 0.5, 1) infinite alternate; }
  .profile { animation: cut 7s cubic-bezier(0.5, 0, 0.5, 1) infinite alternate; }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  @keyframes travel {
    from { transform: translateX(44px); }
    to   { transform: translateX(376px); }
  }
  @keyframes cut {
    from { stroke-dashoffset: 100; }
    to   { stroke-dashoffset: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .wheel, .head, .profile { animation: none; }
    .head { transform: translateX(376px); }
    .profile { stroke-dashoffset: 0; }
  }
</style>
