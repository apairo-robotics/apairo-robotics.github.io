---
import Machinery from "./Machinery.astro";
---

<section class="hero">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow" data-reveal>Robotics sensor-data stack</p>

      <h1 data-reveal style="--delay: 80ms">
        From raw <span class="ink-spark">bags</span> to
        training-ready <span class="serif-it">datasets</span>.
      </h1>

      <p class="lede" data-reveal style="--delay: 160ms">
        <strong>apairo</strong> is an open, modular toolkit for robotics sensor data.
        Profile any dataset in one command, then load, sync, transform and visualise
        LiDAR, images and trajectories through one numpy-native API.
      </p>

      <div class="hero-actions" data-reveal style="--delay: 240ms">
        <a class="btn" href="#profile">
          Profile a dataset
          <svg class="arrow arrow--down" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 5v14M6 13l6 6 6-6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a class="btn btn--ghost" href="https://apairo-robotics.github.io/apairo/" target="_blank" rel="noopener">
          Read the docs
        </a>
      </div>

      <div class="install" data-reveal style="--delay: 320ms">
        <div class="install-row">
          <span class="install-prompt mono">$</span>
          <code class="mono">pip install apairo</code>
          <button class="install-copy mono" data-copy="pip install apairo" aria-label="Copy install command">copy</button>
        </div>
        <div class="install-row">
          <span class="install-prompt mono">$</span>
          <code class="mono">apairo status ./my_dataset</code>
          <span class="install-note mono"># profile it</span>
        </div>
      </div>
    </div>

    <div class="hero-machine" data-reveal style="--delay: 200ms">
      <Machinery />
      <p class="machine-cap mono">fig.01 — the pipeline, end to end</p>
    </div>
  </div>

  <hr class="rule hero-rule" />
</section>

<style>
  .hero { padding-top: clamp(3.5rem, 8vw, 6rem); padding-bottom: 0; }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    padding-bottom: clamp(3.5rem, 8vw, 6rem);
  }
  .hero-copy { max-width: 38ch; }

  h1 {
    font-size: clamp(2.7rem, 6.4vw, 4.9rem);
    margin-top: 1.6rem;
    font-weight: 420;
  }
  .ink-spark { color: var(--spark-ink); }
  .serif-it { font-style: italic; font-weight: 430; }

  .lede {
    margin-top: 1.7rem;
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    color: var(--ink-2);
    max-width: 44ch;
  }
  .lede strong { font-weight: 600; }

  .hero-actions {
    margin-top: 2.2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }
  .btn:hover .arrow--down { transform: translateY(3px); }

  .install {
    margin-top: 1.8rem;
    display: inline-flex;
    flex-direction: column;
    gap: 0.45rem;
    background: var(--paper-soft);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 0.6rem 0.7rem 0.6rem 0.95rem;
    font-size: 0.9rem;
  }
  .install-row {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 1.9rem;
  }
  .install-prompt { color: var(--spark-ink); }
  .install code { color: var(--ink); letter-spacing: -0.01em; white-space: nowrap; }
  .install-note {
    white-space: nowrap;
    margin-left: 0.3rem;
    font-size: 0.74rem;
    color: var(--steel);
  }
  .install-copy {
    margin-left: 0.3rem;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--steel);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 0.32em 0.6em;
    cursor: pointer;
    transition: color 0.25s var(--ease), border-color 0.25s var(--ease);
  }
  .install-copy:hover { color: var(--ink); border-color: var(--line-strong); }
  .install-copy[data-done]::after { content: "✓"; }

  .hero-machine {
    justify-self: end;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1rem;
  }
  .machine-cap { font-size: 0.7rem; color: var(--steel); letter-spacing: 0.08em; }

  .hero-rule { opacity: 0.8; }

  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-machine { justify-self: start; align-items: flex-start; order: -1; max-width: 420px; }
    .machine-cap { align-self: flex-start; }
  }
  @media (max-width: 420px) {
    .install { font-size: 0.8rem; }
    .install-note { display: none; }
  }
</style>
