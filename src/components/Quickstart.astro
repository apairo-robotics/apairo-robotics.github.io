---
import { Code } from "astro:components";

const snippet = `import apairo
from apairo_transform import RangeFilter, RandomSubsample

# 1 · Load — any folder apairo has profiled
ds = apairo.RawDataset(
    "/data/field_run_01",
    keys=["lidar", "imu", "cmd"],
)

# 2 · Sync — multi-rate sensors onto the lidar clock
view = ds.synchronize(
    reference="lidar", method="nearest", tolerance=0.05
)

# 3 · Transform — lazy, on access, nothing written to disk
view.transform("lidar", RangeFilter(max=50.0))
view.transform("lidar", RandomSubsample(1024))

# 4 · Use — plain numpy, ready for any framework
sample = view[0]
sample.data["lidar"]   # ndarray (1024, 4)  float32
sample.data["imu"]     # ndarray (6,)       float64
`;
---

<section id="quickstart" class="section quickstart">
  <div class="wrap qs-grid">
    <div class="qs-copy" data-reveal>
      <p class="eyebrow">04 / Quickstart</p>
      <h2>Loaded and training in a&nbsp;dozen lines.</h2>
      <p class="qs-lede">
        The core ships on PyPI. Add only the layers you need — every package
        speaks the same numpy-native data model, so nothing has to be glued
        together by hand.
      </p>

      <ol class="qs-steps mono">
        <li><span>Load</span> any profiled folder — or a built-in dataset class.</li>
        <li><span>Sync</span> sensors running at different rates onto one clock.</li>
        <li><span>Transform</span> lazily — augment on access, leave disk untouched.</li>
        <li><span>Use</span> raw arrays in PyTorch, JAX, anything.</li>
      </ol>

      <a class="btn" href="https://apairo-robotics.github.io/apairo/" target="_blank" rel="noopener">
        Full documentation
        <svg class="arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M7 17 17 7M9 7h8v8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>

    <div class="qs-code" data-reveal style="--delay: 120ms">
      <div class="code-bar mono">
        <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="code-file">quickstart.py</span>
      </div>
      <div class="code-body code-tokens">
        <Code code={snippet} lang="python" theme="css-variables" />
      </div>
    </div>
  </div>
</section>

<style>
  .qs-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .qs-copy { max-width: 40ch; }
  .section-head + *, .qs-copy h2 { margin-top: 1.1rem; }
  .qs-copy h2 { font-size: clamp(1.9rem, 4vw, 2.9rem); }
  .qs-lede { margin-top: 1.3rem; color: var(--ink-2); }

  .qs-steps {
    list-style: none;
    counter-reset: s;
    margin: 1.8rem 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .qs-steps li {
    counter-increment: s;
    position: relative;
    padding-left: 2.4rem;
    font-size: 0.86rem;
    color: var(--ink-2);
    line-height: 1.5;
  }
  .qs-steps li::before {
    content: counter(s, decimal-leading-zero);
    position: absolute;
    left: 0; top: 0;
    color: var(--spark-ink);
    font-size: 0.78rem;
    letter-spacing: 0.05em;
  }
  .qs-steps span { color: var(--ink); font-weight: 500; }

  /* code card */
  .qs-code {
    min-width: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--paper-soft);
    box-shadow: 0 30px 60px -40px rgba(35, 44, 54, 0.5);
  }
  .code-bar {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--line);
    background: var(--paper-deep);
  }
  .dots { display: inline-flex; gap: 6px; }
  .dots i {
    width: 9px; height: 9px;
    border-radius: 50%;
    background: var(--line-strong);
  }
  .dots i:first-child { background: var(--spark); }
  .code-file { font-size: 0.72rem; color: var(--steel); letter-spacing: 0.05em; }

  .code-body {
    padding: 1.3rem 1.4rem;
    overflow-x: auto;
  }
  .code-body :global(pre) {
    font-size: 0.8rem;
    line-height: 1.75;
  }

  @media (max-width: 820px) {
    .qs-grid { grid-template-columns: 1fr; }
  }
</style>
